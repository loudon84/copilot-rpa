# 服务
APP_NAME=nodeskclaw-rpa-engine
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=4610
RPA_ENGINE_PUBLIC_BASE_URL=http://127.0.0.1:4610
LOG_LEVEL=INFO

# Flow 包
FLOW_PACKAGE_MAX_BYTES=52428800
FLOW_PACKAGE_MAX_UNCOMPRESSED_BYTES=209715200
FLOW_PACKAGE_MAX_FILES=500
FLOW_PACKAGE_MAX_COMPRESSION_RATIO=100
FLOW_PACKAGE_URL_TTL_SECONDS=900

# PostgreSQL。应用启动时绝不会创建或迁移 Schema 对象。
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_SCHEMA=rpa_engine
DATABASE_POOL_SIZE=5

# S3 兼容的 Flow 包存储。bucket 必须预先存在。
MINIO_ENABLED=false
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rpa-flow-packages
MINIO_REGION=us-east-1

# nodeskclaw-task
TASK_API_BASE_URL=http://127.0.0.1:4520/api/v1/autotask
# 可选的 Engine 可达源地址，仅用于替换 Artifact 上传 URL 中的回环地址。
TASK_ARTIFACT_UPLOAD_BASE_URL=
TASK_AUTH_MODE=none
TASK_CLIENT_ID=
TASK_CLIENT_SECRET=
TASK_API_TIMEOUT_SECONDS=10

# 内部 Worker Pool。在 Runtime Handler 就绪前，Lease 轮询保持关闭。
WORKER_ENABLED=false
WORKER_LEASE_ENABLED=false
WORKER_ID=server-worker-001
WORKER_TYPE=SERVER_WORKER
WORKER_DEVICE_NAME=nodeskclaw-rpa-engine
WORKER_CAPABILITIES=["PLAYWRIGHT_CDP","BROWSER_SESSION_MANAGED","SCREENSHOT","DOWNLOAD"]
WORKER_TAGS=[]
WORKER_AGENT_VERSION=
WORKER_OS=
WORKER_MAX_CONCURRENT_RUNS=1
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_RENEW_INTERVAL_SECONDS=20
WORKER_OFFLINE_THRESHOLD_SECONDS=45
WORKER_SHUTDOWN_GRACE_SECONDS=30

# Phase 4 Runtime。在专用 E2E 验证通过前，真实 Lease 保持关闭。
RUNTIME_ENABLED=false
RUNTIME_CACHE_DIR=runtime-cache/flows
RUNTIME_WORK_DIR=runtime-cache/runs
RUNTIME_TIMEOUT_SECONDS=900
RUNTIME_MAX_RETRIES=2
RUNTIME_RETRY_BACKOFF_SECONDS=1
RUNTIME_CLEANUP_ON_FINISH=true
RUNTIME_TRACE_MODE=ON_FAILURE
RUNTIME_OUTPUT_MAX_BYTES=1048576
ARTIFACT_MAX_BYTES=209715200

# 凭据解析。mock_env 仅允许在 development/test 环境使用，且必须限定到
# 一个专用 credential、tenant 和 Portal account。
CREDENTIAL_RESOLVER_MODE=disabled
MOCK_SRM_CREDENTIAL_REF=
MOCK_SRM_USERNAME=
MOCK_SRM_PASSWORD=
MOCK_SRM_ALLOWED_TENANT_ID=
MOCK_SRM_ALLOWED_PORTAL_ACCOUNT_ID=

# 独立的 Phase 5 Mock SRM 演示服务。Engine 启动时绝不会自动启动该服务。
MOCK_SRM_HOST=127.0.0.1
MOCK_SRM_PORT=4600
MOCK_SRM_LOG_LEVEL=INFO
